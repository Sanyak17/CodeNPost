# Server
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/codenpost

# JWT
JWT_SECRET=replace_with_a_long_random_string

# GitHub
GITHUB_TOKEN=your_github_personal_access_token

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# LinkedIn OAuth (from LinkedIn Developer App)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/linkedin/callback

# Cron schedule (default: every day at 9am)
CRON_SCHEDULE=0 9 * * *
